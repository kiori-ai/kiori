# Kiori configuration. Copy to .env and fill in. (The older PSYCHE_* names are still read.)
# The model key for projects on this server's own key; customer projects bring their own brain API key.
KIORI_LLM_KEY=
# KIORI_LLM_BASE_URL=https://openrouter.ai/api/v1
# KIORI_ORGANIZER_MODEL=anthropic/claude-haiku-5.5
# KIORI_AUDITOR_MODEL=anthropic/claude-haiku-5.5
# KIORI_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# KIORI_EMBED_MODEL=openai/text-embedding-3-small
# KIORI_LEARN_EVERY=12
# KIORI_LEARN_HOLD=4
# KIORI_PUBLIC_URL=https://api.kiori.io
# PORT=7700
