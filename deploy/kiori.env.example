# Kiori's settings on the server. setup.sh copies this file to /etc/kiori/kiori.env (owner root, group kiori, mode
# 640) once and never overwrites it after that: fill it in there, by hand. kiori.service reads it, and so does
# `sudo kiori` (the command line).
#
# Moving a Kiori that runs somewhere else: take the values from its .env. To list its setting names without their
# values: sed 's/=.*//' .env
#
# Format: KEY=value, one per line, no "export", no spaces around "=". Quote a value only if it has spaces or a #.
# The older PSYCHE_* names work too.
#
# Not here: KIORI_DATA, KIORI_HOST and PORT. kiori.service fixes them (/var/lib/kiori, 127.0.0.1, 7700); lines for
# them in this file are ignored.

# Where customers reach Kiori; sign-in links point here.
KIORI_PUBLIC_URL=https://api.example.com

# Cloudflare's tunnel is the proxy in front of Kiori here, so the caller's address is read from CF-Connecting-IP.
KIORI_TRUST_PROXY=cloudflare

# The model key for projects on this server's own key (llm_mode "server").
KIORI_LLM_KEY=

# Only if the old .env sets KIORI_SECRET: the very same value, or the customers' sealed model keys won't open.
# When set, it wins over secret.key; when not, Kiori uses secret.key in the data folder.
#KIORI_SECRET=

# Only if the old .env sets it. Otherwise the admin key is admin.key in the data folder.
#KIORI_ADMIN_KEY=

# The rest have defaults (docs/self-hosting.md). Copy any that the old .env changes.
#KIORI_LLM_BASE_URL=https://openrouter.ai/api/v1
#KIORI_ORGANIZER_MODEL=anthropic/claude-haiku-5.5
#KIORI_AUDITOR_MODEL=anthropic/claude-haiku-5.5
#KIORI_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
#KIORI_PROVIDER_SORT=throughput
#KIORI_EMBED_MODEL=openai/text-embedding-3-small
#KIORI_EMBED=1
#KIORI_LEARN_EVERY=12
#KIORI_LEARN_HOLD=4
#KIORI_PROXY_ALLOW_LOCAL=0
